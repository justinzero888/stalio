# Stalio Environment Variables
# Copy this file to .env and fill in production values.
# These are injected at build time via --dart-define flags.

# Environment: development | staging | production
APP_ENV=development

# AdMob — required for production
ADMOB_APP_ID_ANDROID=ca-app-pub-7497527413129091~1493778160
ADMOB_APP_ID_IOS=ca-app-pub-7497527413129091~5735736505
ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-7497527413129091/1333457063
ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-7497527413129091/1302206478

# Build commands:
# Development (uses test IDs):
#   flutter run
#
# Staging (uses test IDs):
#   flutter run --dart-define=APP_ENV=staging
#
# Production (uses real AdMob IDs):
#   flutter build appbundle --dart-define=APP_ENV=production \
#     --dart-define=ADMOB_APP_ID_ANDROID=ca-app-pub-7497527413129091~1493778160 \
#     --dart-define=ADMOB_APP_ID_IOS=ca-app-pub-7497527413129091~5735736505 \
#     --dart-define=ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-7497527413129091/1333457063 \
#     --dart-define=ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-7497527413129091/1302206478
#
#   flutter build ipa --dart-define=APP_ENV=production \
#     --dart-define=ADMOB_APP_ID_ANDROID=ca-app-pub-7497527413129091~1493778160 \
#     --dart-define=ADMOB_APP_ID_IOS=ca-app-pub-7497527413129091~5735736505 \
#     --dart-define=ADMOB_BANNER_UNIT_ID_ANDROID=ca-app-pub-7497527413129091/1333457063 \
#     --dart-define=ADMOB_BANNER_UNIT_ID_IOS=ca-app-pub-7497527413129091/1302206478
